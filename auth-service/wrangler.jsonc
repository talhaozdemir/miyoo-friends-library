{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miyoo-friends-auth",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "vars": {
    "PUBLIC_ORIGIN": "https://REPLACE.workers.dev",
    "GOOGLE_CLIENT_ID": "REPLACE.apps.googleusercontent.com",
    "ROOT_FOLDER_ID": "REPLACE"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "miyoo-friends-auth",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["17 * * * *"] }
}
